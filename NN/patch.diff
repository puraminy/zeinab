 TEMPORAL_DERIVED_COLUMN_PATTERN = re.compile(
     r".+__(diff|lag|seqdiff|ratio|accel|normchg|roll_mean|roll_std|roll_min|roll_max|roll_range|roll_slope)_\d+$"
