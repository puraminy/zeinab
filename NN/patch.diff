+def _safe_feature_token(column_name):
+    """Return a compact, stable token for engineered feature names."""
+    token = re.sub(r"[^0-9A-Za-z]+", "_", str(column_name)).strip("_").lower()
+    return token or "feature"
+
+
+def _fit_feature_clip_bounds(train_df, quantiles=ROBUST_FEATURE_CLIP_QUANTILES):
+    """Fit train-only winsorization bounds to reduce outlier signal distortion."""
+    lower_q, upper_q = quantiles
+    lower_bounds = train_df.quantile(float(lower_q), axis=0, numeric_only=True)
+    upper_bounds = train_df.quantile(float(upper_q), axis=0, numeric_only=True)
+    invalid_bounds = ~(np.isfinite(lower_bounds) & np.isfinite(upper_bounds)) | (lower_bounds > upper_bounds)
+    lower_bounds[invalid_bounds] = train_df.min(axis=0, numeric_only=True)[invalid_bounds]
+    upper_bounds[invalid_bounds] = train_df.max(axis=0, numeric_only=True)[invalid_bounds]
+    return lower_bounds, upper_bounds
+
+
+def _apply_feature_clip_bounds(dataframe, lower_bounds, upper_bounds):
+    """Apply fitted clipping bounds while preserving columns and index."""
+    clipped = dataframe.copy()
+    aligned_lower = lower_bounds.reindex(clipped.columns)
+    aligned_upper = upper_bounds.reindex(clipped.columns)
+    return clipped.clip(lower=aligned_lower, upper=aligned_upper, axis=1)
+
+
+def _rank_columns_for_hierarchy(train_df):
+    """Rank process signals by train-set variability for bounded feature expansion."""
+    std = train_df.std(axis=0, ddof=0).replace([np.inf, -np.inf], np.nan).fillna(0.0)
+    dynamic_range = (train_df.max(axis=0) - train_df.min(axis=0)).replace([np.inf, -np.inf], np.nan).fillna(0.0)
+    score = (std * dynamic_range).sort_values(ascending=False)
+    return [column for column in score.index if score[column] > 0]
+
+
+def _engineer_single_feature_frame(dataframe, ranked_columns, interaction_pairs, ratio_pairs):
+    """Create hierarchical tabular features without changing model classes."""
+    engineered = dataframe.copy()
+    epsilon = 1e-6
+
+    for column in ranked_columns:
+        values = dataframe[column].astype(float)
+        token = _safe_feature_token(column)
+        engineered[f"{token}__squared"] = values ** 2
+        engineered[f"{token}__abs"] = values.abs()
+
+    for left, right in interaction_pairs:
+        left_values = dataframe[left].astype(float)
+        right_values = dataframe[right].astype(float)
+        engineered[f"{_safe_feature_token(left)}__x__{_safe_feature_token(right)}"] = left_values * right_values
+        engineered[f"{_safe_feature_token(left)}__minus__{_safe_feature_token(right)}"] = left_values - right_values
+
+    for numerator, denominator in ratio_pairs:
+        numerator_values = dataframe[numerator].astype(float)
+        denominator_values = dataframe[denominator].astype(float)
+        safe_denominator = denominator_values.where(denominator_values.abs() > epsilon, np.sign(denominator_values) * epsilon)
+        safe_denominator = safe_denominator.replace(0.0, epsilon).fillna(epsilon)
+        engineered[f"{_safe_feature_token(numerator)}__over__{_safe_feature_token(denominator)}"] = numerator_values / safe_denominator
+
+    engineered = engineered.replace([np.inf, -np.inf], np.nan)
+    engineered = engineered.fillna(engineered.median(axis=0, numeric_only=True)).fillna(0.0)
+    return engineered
+
+
+def engineer_refinery_feature_hierarchy(X_train_df, X_test_df):
+    """Build leakage-safe robust and hierarchical refinery features.
+
+    The model architecture is preserved: existing estimators are still trained as
+    before, but their input matrix receives train-fitted clipping plus bounded
+    second-order, interaction, and ratio features.  This exposes process
+    hierarchy that tree/boosting models can use without target leakage.
+    """
+    lower_bounds, upper_bounds = _fit_feature_clip_bounds(X_train_df)
+    clipped_train = _apply_feature_clip_bounds(X_train_df, lower_bounds, upper_bounds)
+    clipped_test = _apply_feature_clip_bounds(X_test_df, lower_bounds, upper_bounds)
+
+    ranked_columns = _rank_columns_for_hierarchy(clipped_train)
+    nonlinear_columns = ranked_columns[: min(len(ranked_columns), MAX_HIERARCHICAL_INTERACTION_FEATURES)]
+    interaction_pairs = []
+    for left_index, left in enumerate(nonlinear_columns):
+        for right in nonlinear_columns[left_index + 1 :]:
+            interaction_pairs.append((left, right))
+            if len(interaction_pairs) >= MAX_HIERARCHICAL_INTERACTION_FEATURES:
+                break
+        if len(interaction_pairs) >= MAX_HIERARCHICAL_INTERACTION_FEATURES:
+            break
+
+    ratio_pairs = []
+    for left, right in interaction_pairs:
+        if len(ratio_pairs) >= MAX_HIERARCHICAL_RATIO_FEATURES:
+            break
+        ratio_pairs.append((left, right))
+
+    train_engineered = _engineer_single_feature_frame(clipped_train, nonlinear_columns, interaction_pairs, ratio_pairs)
+    test_engineered = _engineer_single_feature_frame(clipped_test, nonlinear_columns, interaction_pairs, ratio_pairs)
+    test_engineered = test_engineered.reindex(columns=train_engineered.columns, fill_value=0.0)
+
+    metadata = {
+        "raw_feature_count": int(X_train_df.shape[1]),
+        "engineered_feature_count": int(train_engineered.shape[1]),
+        "nonlinear_feature_count": int(len(nonlinear_columns) * 2),
+        "interaction_feature_count": int(len(interaction_pairs) * 2),
+        "ratio_feature_count": int(len(ratio_pairs)),
+        "clip_quantiles": tuple(float(q) for q in ROBUST_FEATURE_CLIP_QUANTILES),
+        "raw_feature_names": list(X_train_df.columns),
+        "engineered_feature_names": list(train_engineered.columns),
+        "clip_lower_bounds": lower_bounds.to_dict(),
+        "clip_upper_bounds": upper_bounds.to_dict(),
+        "nonlinear_columns": list(nonlinear_columns),
+        "interaction_pairs": list(interaction_pairs),
+        "ratio_pairs": list(ratio_pairs),
+    }
+    LOGGER.info("Refinery feature hierarchy metadata: %s", metadata)
+    return train_engineered, test_engineered, metadata
+
+
+def transform_with_refinery_feature_hierarchy(dataframe, metadata):
+    """Apply a fitted hierarchy transform to new raw rows."""
+    raw_feature_names = metadata.get("raw_feature_names") or list(dataframe.columns)
+    raw_df = dataframe_from_tabular(dataframe, "X", columns=raw_feature_names)
+    lower_bounds = pd.Series(metadata.get("clip_lower_bounds", {})).reindex(raw_feature_names)
+    upper_bounds = pd.Series(metadata.get("clip_upper_bounds", {})).reindex(raw_feature_names)
+    clipped = _apply_feature_clip_bounds(raw_df, lower_bounds, upper_bounds)
+    engineered = _engineer_single_feature_frame(
+        clipped,
+        metadata.get("nonlinear_columns", []),
+        metadata.get("interaction_pairs", []),
+        metadata.get("ratio_pairs", []),
+    )
+    return engineered.reindex(columns=metadata.get("engineered_feature_names", engineered.columns), fill_value=0.0)
+
+
+def robust_clip_refinery_features(X_train_df, X_test_df):
+    """Apply train-only winsorization when feature expansion is not possible."""
+    lower_bounds, upper_bounds = _fit_feature_clip_bounds(X_train_df)
+    return (
+        _apply_feature_clip_bounds(X_train_df, lower_bounds, upper_bounds),
+        _apply_feature_clip_bounds(X_test_df, lower_bounds, upper_bounds),
+    )
 
 
